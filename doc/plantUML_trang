@startuml
skinparam dpi 300
scale 1.3
skinparam defaultFontSize 22

autonumber
actor "Người dùng" as User
participant "ReactJS Frontend" as FE
participant "Express Backend" as BE
database "MySQL DB" as DB

User -> FE: 1. Nhập Username & Password
User -> FE: 2. Click "Đăng nhập"
FE -> BE: 3. POST /api/v1/auth/login {username, password}
activate BE

BE -> DB: 4. SELECT * FROM users WHERE username = ?
activate DB
DB --> BE: 5. Trả về thông tin Người dùng
deactivate DB

alt User không tồn tại
    BE --> FE: 6a. Trả về 401 Unauthorized ("Tài khoản hoặc mật khẩu sai")
    FE --> User: 7a. Hiển thị thông báo sai thông tin
else User tồn tại
    BE -> BE: 6b. Bcrypt.compare(password, password_hash)
    alt Mật khẩu không đúng
        BE --> FE: 7b1. Trả về 401 Unauthorized
        FE --> User: 8b1. Hiển thị thông báo sai mật khẩu
    else Mật khẩu đúng
        BE -> BE: 7b2. Tạo JWT Token {id, username, role}
        BE --> FE: 8b2. Trả về 200 OK {token, user: {id, username, role, full_name}}
        deactivate BE
        FE -> FE: 9. Lưu JWT Token vào LocalStorage

        alt Role == 'ADMIN'
            FE --> User: 10a. Điều hướng tới Dashboard
        else Role == 'TENANT'
            FE --> User: 10b. Điều hướng tới Trang Khách thuê
        end
    end
end
@enduml



  stop
else (Có)
  |Hệ thống|
  if (is_active == FALSE?) then (Có)
    |Người dùng|
    :Thông báo "Tài khoản bị khóa";
    stop
  else (Không)
    |Hệ thống|
    :So sánh Password với `password_hash`;
    if (Khớp mật khẩu?) then (Không)
      |Người dùng|
      :Thông báo "Tài khoản hoặc mật khẩu không đúng";
      stop
    else (Có)
      |Hệ thống|
      :Tạo mã JWT Token (chứa id, role);
      :Trả Token về Client;

      |Người dùng|
      :Lưu Token vào LocalStorage;
      if (Role == 'ADMIN'?) then (Có)
        :Điều hướng đến Dashboard Admin;
      else (Không)
        :Điều hướng đến Trang Khách thuê;
      endif
      stop
    endif
  endif
endif
@enduml


left to right direction
' ================= TÙY CHỈNH KÍCH THƯỚC CHỮ VÀ KHOẢNG CÁCH =================
skinparam defaultFontName "Arial"
skinparam defaultFontSize 16

' Tăng cỡ chữ và độ đệm cho UseCase
skinparam usecase {
    FontSize 16
    Padding 10
}

' Tăng cỡ chữ cho Actor
skinparam actor {
    FontSize 16
}

' Chỉnh khoảng cách giữa các khối để tối ưu diện tích
skinparam nodesep 10
skinparam ranksep 60
skinparam packageStyle rectangle

actor "Khách / Người dùng" as Guest
actor "Chủ trọ (Admin)" as Admin
actor "Người thuê (Tenant)" as Tenant

Admin --|> Guest
Tenant --|> Guest

rectangle "Quản lý phòng trọ" {
    ' Module Auth (Trang phụ trách)
    usecase "Đăng ký tài khoản khách thuê" as UC_Register
    usecase "Đăng nhập" as UC_Login
    usecase "Xem thông tin cá nhân & phòng" as UC_Profile
    usecase "Xem báo cáo & dashboard" as UC_Dashboard

    ' Module Phòng & Tiện nghi (Bình)
    usecase "Quản lý phòng & loại phòng" as UC_Room
    usecase "Gán tiện nghi" as UC_Amenity

    ' Module Khách thuê & Hợp đồng (Ngọc)
    usecase "Quản lý hồ sơ khách thuê" as UC_Tenant
    usecase "Quản lý hợp đồng thuê" as UC_Contract

    ' Module Điện nước & Hóa đơn (Linh)
    usecase "Ghi chỉ số điện/nước" as UC_Utility
    usecase "Tự động sinh hóa đơn" as UC_Invoice
    usecase "Ghi nhận thanh toán" as UC_Payment

    ' Module Sự cố & Thông báo (Bình)
    usecase "Gửi yêu cầu báo hỏng" as UC_Maint_Tenant
    usecase "Xử lý yêu cầu sự cố" as UC_Maint_Admin
    usecase "Gửi & nhận thông báo" as UC_Notification
}

' Nối Guest
Guest --> UC_Register
Guest --> UC_Login

' Nối Tenant (Đã bổ sung Nhận thông báo)

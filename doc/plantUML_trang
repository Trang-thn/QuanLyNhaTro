@startuml
skinparam dpi 300
scale 1.3
skinparam defaultFontSize 22

autonumber
actor "Khách" as Guest
participant "ReactJS Frontend" as FE
participant "Express Backend" as BE
database "MySQL DB" as DB

Guest -> FE: 1. Nhập Username, Password, Họ tên, SĐT, Số CCCD, Email
Guest -> FE: 2. Click "Đăng ký"
FE -> BE: 3. POST /api/v1/auth/register
BE -> DB: 4. SELECT * FROM users WHERE username = ?
activate DB
DB --> BE: 5. Trả về null (nếu chưa tồn tại)
deactivate DB

alt Username đã tồn tại
    BE --> FE: 6a. Trả về 400 Bad Request ("Username đã tồn tại")
    FE --> Guest: 7a. Thông báo lỗi
else Username hợp lệ
    BE -> BE: 6b. Mã hóa mật khẩu
    BE -> DB: 7b. INSERT INTO users (id, username, password_hash, full_name, phone_number, role)\nVALUES (?, ?, ?, ?, ?, 'TENANT')
    activate DB
    DB --> BE: 8b. Trả về user_id mới
    deactivate DB

    BE -> DB: 9b. SELECT id FROM tenants WHERE identity_card_number = ?
    activate DB
    DB --> BE: 10b. Trả về tenant_id (nếu có)
    deactivate DB

    opt Tìm thấy Hồ sơ Tenant có cùng CCCD
        BE -> DB: 11b. UPDATE tenants SET user_id = ? WHERE identity_card_number = ?
        activate DB
        DB --> BE: 12b. Cập nhật liên kết thành công
        deactivate DB
    end

    BE --> FE: 13b. Trả về 201 Created ("Đăng ký thành công")
    deactivate BE
    FE --> Guest: 14b. Thông báo thành công & Chuyển sang Đăng nhập
end
@enduml




Tenant --> UC_Maint_Tenant
Tenant --> UC_Notification

' Nối Admin
Admin --> UC_Dashboard
Admin --> UC_Room
Admin --> UC_Amenity
Admin --> UC_Tenant
Admin --> UC_Contract
Admin --> UC_Utility
Admin --> UC_Invoice
Admin --> UC_Payment
Admin --> UC_Maint_Admin
Admin --> UC_Notification
@enduml


